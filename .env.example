# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Personal Anthropic API key (https://console.anthropic.com) — NOT company Bedrock.
ANTHROPIC_API_KEY=sk-ant-...

# Local DataHub GMS endpoint. Quickstart default is 8080; this project uses 8081
# to avoid a local port conflict (see docs/setup.md).
DATAHUB_GMS_URL=http://localhost:8081
DATAHUB_GMS_TOKEN=

# GitHub token for opening fix PRs (repo scope). Used only by the healing module.
GITHUB_TOKEN=
